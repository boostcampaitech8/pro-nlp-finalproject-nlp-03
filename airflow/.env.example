# airflow/.env.example
# 이 파일을 airflow/.env로 복사한 뒤 값을 채워 사용합니다. (.env는 git에 올리지 않습니다)

# Airflow 컨테이너 실행 UID (Linux: `id -u` 결과)
AIRFLOW_UID=50000

# MongoDB root 계정 (docker-compose의 mongodb, mongo-express가 사용)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me

# DAG에서 사용하는 MongoDB 접속 URI (위 계정과 일치해야 함)
MONGO_URI=mongodb://root:change-me@mongodb:27017/admin

# CLOVA Studio 임베딩 API 키 (bge-m3 임베딩 호출)
CLOVASTUDIO_API_KEY=
